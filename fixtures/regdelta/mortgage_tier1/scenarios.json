{
  "schema_version": "regdelta-tier1-scenarios/1.0",
  "note": "Hand-authored gold cases for the mortgage Tier 1 fixture (plan/regdelta-product-plan.md Section 4.1). Each scenario supplies inputs for one edited rule's own condition_predicates, the loan_type/transaction_type values its applicability_scope requires (see utils.lexec_ir's scope.predicate extension -- without these the rule reads 'unknown' regardless of the edited threshold), and (where applicable) its known DAG dependent's unrelated predicate variable, which is deliberately never supplied here -- the dependent (R-120-003, B8-MBS-LOAN-001/002) is requires_review:true and is expected to read 'unresolved-review' regardless of what its own evaluation would say.",
  "scenarios": [
    {
      "case_id": "r120004_boundary_79_no_enhancement",
      "description": "LTV 79%: below the old 80% trigger, above the new 78% trigger.",
      "inputs": {
        "loan_type": "conventional first mortgage loan",
        "transaction_type": "Fannie Mae portfolio purchase",
        "conventional_first_mortgage": true,
        "ltv_ratio_percent": 79,
        "another_charter_compliant_credit_enhancement_provided": false,
        "fannie_mae_purchase_or_securitization": true
      },
      "targets": ["R-120-004", "R-120-003"],
      "expected": {
        "R-120-004": {"old_status": "no_match", "new_status": "matched", "differs": true},
        "R-120-003": {"status": "unresolved-review"}
      }
    },
    {
      "case_id": "r120004_clearly_above_both_thresholds",
      "description": "LTV 90%: above both the old and new trigger -- PMI required either way.",
      "inputs": {
        "loan_type": "conventional first mortgage loan",
        "transaction_type": "Fannie Mae portfolio purchase",
        "conventional_first_mortgage": true,
        "ltv_ratio_percent": 90,
        "another_charter_compliant_credit_enhancement_provided": false,
        "fannie_mae_purchase_or_securitization": true
      },
      "targets": ["R-120-004", "R-120-003"],
      "expected": {
        "R-120-004": {"old_status": "matched", "new_status": "matched", "differs": false},
        "R-120-003": {"status": "unresolved-review"}
      }
    },
    {
      "case_id": "r120004_clearly_below_both_thresholds",
      "description": "LTV 70%: below both thresholds -- PMI not required either way.",
