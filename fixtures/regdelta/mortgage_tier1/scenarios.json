        "loan_type": "conventional first mortgage loan",
        "transaction_type": "Fannie Mae portfolio purchase",
        "conventional_first_mortgage": true,
        "ltv_ratio_percent": 70,
        "another_charter_compliant_credit_enhancement_provided": false,
        "fannie_mae_purchase_or_securitization": true
      },
      "targets": ["R-120-004", "R-120-003"],
      "expected": {
        "R-120-004": {"old_status": "no_match", "new_status": "no_match", "differs": false},
        "R-120-003": {"status": "unresolved-review"}
      }
    },
    {
      "case_id": "r120004_boundary_79_but_alternate_enhancement_present",
      "description": "Same 79% boundary LTV, but an alternate credit enhancement is present. R-120-004's own condition already requires 'no alternate enhancement' (predicate p3), so this fails on the condition itself (no_match) on both sides regardless of the threshold edit -- the rule's separately-declared exception for the same variable being true is, by construction, unreachable here.",
      "inputs": {
        "loan_type": "conventional first mortgage loan",
        "transaction_type": "Fannie Mae portfolio purchase",
        "conventional_first_mortgage": true,
        "ltv_ratio_percent": 79,
        "another_charter_compliant_credit_enhancement_provided": true,
        "fannie_mae_purchase_or_securitization": true
      },
      "targets": ["R-120-004"],
      "expected": {
        "R-120-004": {"old_status": "no_match", "new_status": "no_match", "differs": false}
      }
    },
    {
      "case_id": "r120004_wrong_loan_type_is_out_of_scope",
