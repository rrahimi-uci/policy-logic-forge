# Dependencies
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Generated NeurIPS paper build output (regenerable)
paper/build/

# Secrets
.env
.env.*
!.env.example
config.json

# Local databases (adaptive limiter state)
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Generated pipeline output (regenerable; see benchmarks/README.md for how
# to reproduce a run)
pipeline-output/

# Local pilot-sized samples for the redistribution-restricted domains
# (OPP-115, MAPP — no redistribution grant; see README.md "Data and
# licensing"). Nothing is committed under compliance-files/ for any domain
# — this just covers the folder name if you create one locally by hand.
compliance-files/privacy_policy_pilot/
compliance-files/mobile_app_privacy_pilot/

# Benchmark corpora (downloaded, not vendored — see benchmarks/README.md)
benchmarks/data/
benchmarks/raw/
benchmarks/*-source-docs/

# Full benchmark corpora copied into compliance-files/<domain>/ for
# full-corpus runs (see benchmarks/README.md "Run the pipeline per
# benchmark"). Regenerable from benchmarks/*-source-docs/ — not committed,
# regardless of license. (Distinct from compliance-files/<domain>_pilot/
# above: no _pilot suffix.)
compliance-files/commercial_contracts/
compliance-files/nda_confidentiality/
compliance-files/privacy_policy/
compliance-files/mobile_app_privacy/
compliance-files/deonticbench/
compliance-files/mortgage/
compliance-files/mortgage-v2/

# UI-driven uploads (see ui/backend/multipart.py's save_upload()). Namespaced
# separately from the curated benchmark domain folders above, which are
# matched by name, not by a general pattern.
compliance-files/uploads/

# OS / editor
.DS_Store
.idea/
.vscode/
