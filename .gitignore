# Dependencies
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Secrets
.env
.env.*
!.env.example
config.json

# Local databases (adaptive limiter state)
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Generated pipeline output (regenerable by re-running the pipeline)
pipeline-output/

# Source documents and locally built corpora. Nothing is committed under
# compliance-files/ for any domain, regardless of content or license — so
# ignore the whole tree rather than enumerating domains one at a time. The
# per-domain list this replaces had already drifted: every directory was
# covered except a newly added one, which was left stageable by accident.
compliance-files/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local Playwright MCP debug artifacts (screenshots/snapshots from manual
# browser verification) -- disposable, never part of a change.
.playwright-mcp/
